#!/bin/sh
# Generated by scripts/build_release.py. Downloaded artifacts are pinned by hash.
set -eu
main() {
    command -v python3 >/dev/null 2>&1 || { echo 'Python 3.11+ is required.' >&2; exit 1; }
    python3 -B - "$@" <<'PY'
import argparse
import fcntl
import hashlib
import json
import os
import shutil
import stat
import subprocess
import sys
import tarfile
import tempfile
import urllib.parse
import urllib.request
import uuid
import venv
from pathlib import Path, PurePosixPath

VERSION = '@VERSION@'
SHA256 = '@BUNDLE_SHA256@'
DEFAULT_URL = '@RELEASE_BASE_URL@'


def install():
    if sys.version_info < (3, 11):
        raise RuntimeError('Python 3.11+ is required; use Ubuntu 24.04 / Debian 12 or newer')
    parser = argparse.ArgumentParser(description='Install an isolated Certbot DNSPod hook')
    parser.add_argument('--base-url', default=DEFAULT_URL, help='Release URL; HTTP allowed only on loopback')
    parser.add_argument('--bundle', type=Path, help='Use a downloaded private/offline release bundle')
    parser.add_argument('--prefix', type=Path, default=Path('/opt/certbot-dnspod-hook'))
    parser.add_argument('--bin-dir', type=Path, default=Path('/usr/local/bin'))
    args = parser.parse_args()
    if not args.prefix.is_absolute() or not args.bin_dir.is_absolute():
        raise RuntimeError('Installation paths must be absolute')
    if os.geteuid() != 0 and (str(args.prefix).startswith('/opt/') or str(args.bin_dir).startswith('/usr/')):
        raise RuntimeError('Run the system installer with sudo sh')
    parsed = urllib.parse.urlsplit(args.base_url)
    if not args.bundle and parsed.scheme != 'https' and not (parsed.scheme == 'http' and parsed.hostname in ('127.0.0.1', '::1', 'localhost')):
        raise RuntimeError('Release URL must use HTTPS (or loopback HTTP for local testing)')
    prefix = args.prefix
    for directory in (prefix, args.bin_dir):
        directory.mkdir(mode=0o755, parents=True, exist_ok=True)
        for path in (directory, *directory.parents):
            info = path.stat()
            # Custom user-owned prefixes support isolated installer tests.
            if info.st_uid not in (0, os.geteuid()) or info.st_mode & 0o022 and not info.st_mode & stat.S_ISVTX:
                raise RuntimeError('Installation directories must not be writable by other users')
    launcher = args.bin_dir / 'certbot-dnspod-hook'
    target = prefix / 'current/bin/certbot-dnspod-hook'
    if os.path.lexists(launcher) and (not launcher.is_symlink() or os.readlink(launcher) != str(target)):
        raise RuntimeError('Existing launcher is not managed by this installer')
    current = prefix / 'current'
    if os.path.lexists(current) and (not current.is_symlink() or current.resolve().parent != prefix / 'versions'):
        raise RuntimeError('Existing current path is not managed by this installer')
    with (prefix / '.install.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        with tempfile.TemporaryDirectory(prefix='.download-', dir=prefix) as temporary:
            work = Path(temporary)
            archive_path = work / 'bundle.tar.gz'
            url = args.base_url.rstrip('/') + '/certbot-dnspod-hook-' + VERSION + '-bundle.tar.gz'
            print('Installing certbot-dnspod-hook ' + VERSION, flush=True)
            if args.bundle:
                shutil.copyfile(args.bundle, archive_path)
            else:
                handlers = [urllib.request.ProxyHandler({})] if parsed.hostname in ('127.0.0.1', '::1', 'localhost') else []
                opener = urllib.request.build_opener(*handlers)
                with opener.open(url, timeout=60) as response, archive_path.open('wb') as stream:
                    shutil.copyfileobj(response, stream)
            if hashlib.sha256(archive_path.read_bytes()).hexdigest() != SHA256:
                raise RuntimeError('Release checksum mismatch; installed version was not changed')
            with tarfile.open(archive_path) as archive:
                for member in archive.getmembers():
                    name = PurePosixPath(member.name)
                    if name.is_absolute() or '..' in name.parts or not member.isfile():
                        raise RuntimeError('Invalid file in release archive')
                    destination = work.joinpath(*name.parts)
                    destination.parent.mkdir(parents=True, exist_ok=True)
                    with archive.extractfile(member) as source, destination.open('xb') as output:
                        shutil.copyfileobj(source, output)
            versions = prefix / 'versions'
            versions.mkdir(exist_ok=True)
            slot = versions / (VERSION + '-' + uuid.uuid4().hex[:12])
            activated = False
            try:
                # pip is supplied in the release: distro ensurepip/python3-venv is not needed.
                venv.EnvBuilder(with_pip=False, symlinks=True).create(slot)
                python = str(slot / 'bin/python')
                bootstrap = list((work / 'wheels').glob('pip-*.whl'))
                if len(bootstrap) != 1:
                    raise RuntimeError('Release is missing its pip bootstrap wheel')
                env = {k: v for k, v in os.environ.items() if k not in ('PYTHONHOME', 'PYTHONPATH', 'VIRTUAL_ENV')}
                env['PYTHONPATH'] = str(bootstrap[0])
                env['PYTHONDONTWRITEBYTECODE'] = '1'
                subprocess.run([python, '-m', 'pip', '--isolated', 'install', '--no-index', '--no-compile', '--no-cache-dir',
                                '--require-hashes', '--find-links', str(work / 'wheels'),
                                '-r', str(work / 'requirements.txt')], env=env, check=True)
                env.pop('PYTHONPATH')
                subprocess.run([python, '-m', 'pip', 'check'], env=env, check=True)
                entry = slot / 'bin/certbot-dnspod-hook'
                entry.write_text(entry.read_text().replace('#!' + python + '\n', '#!' + python + ' -B\n', 1))
                actual = subprocess.check_output([str(slot / 'bin/certbot-dnspod-hook'), '--version'], env=env, text=True).strip()
                if actual != VERSION:
                    raise RuntimeError('Installed version does not match the release')
                if not os.path.lexists(launcher):
                    launcher.symlink_to(target)
                receipt = prefix / 'install.json'
                owned = json.loads(receipt.read_text()) if receipt.exists() else {'version': 1, 'launcher': str(launcher), 'versions': []}
                if current.exists() and current.resolve().name not in owned['versions']:
                    owned['versions'].append(current.resolve().name)
                owned['versions'].append(slot.name)
                metadata = prefix / ('.manifest-' + uuid.uuid4().hex)
                try:
                    metadata.write_text(json.dumps(owned, indent=2) + '\n')
                    metadata.chmod(0o600)
                    os.replace(metadata, receipt)
                finally:
                    metadata.unlink(missing_ok=True)
                switch = prefix / ('.current-' + uuid.uuid4().hex)
                try:
                    switch.symlink_to(slot)
                    os.replace(switch, current)
                finally:
                    switch.unlink(missing_ok=True)
                activated = True
                print('Installed ' + VERSION + ': ' + str(launcher), flush=True)
                print('Next: sudo certbot-dnspod-hook setup --cert-name DOMAIN --zone ZONE --credentials-file FILE --renew-now')
            finally:
                if not activated:
                    shutil.rmtree(slot, ignore_errors=True)


try:
    install()
except (OSError, RuntimeError, ValueError, tarfile.TarError, subprocess.SubprocessError) as exc:
    print('Installation failed: ' + str(exc), file=sys.stderr)
    sys.exit(1)
PY
}
main "$@"
